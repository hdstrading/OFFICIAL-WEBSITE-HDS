# Apache configuration for hosting the built website on IONOS Web Hosting.
#
# ONLY needed for the split setup, where the site is static on the IONOS
# webspace and the API runs separately on a VPS. If you serve everything from
# one VPS, ignore this file — the Node server already handles all of it.
#
# Upload this file to the document root alongside index.html. Note the leading
# dot: many FTP clients hide it, so switch on "show hidden files" if you cannot
# see it after uploading.
#
# BEFORE UPLOADING: replace api.hdstradingopc.com below with your real API
# subdomain if you chose a different one.

# ---------------------------------------------------------------- HTTPS + www
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Force HTTPS. IONOS terminates TLS upstream, so check the forwarded header
  # as well as Apache's own HTTPS variable.
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # One canonical address for search engines: send www to the bare domain.
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

  # ------------------------------------------------------------ SPA routing
  # The site is a single-page app: /products, /book, /order/HDS-ORD-… and every
  # other route exists only in the browser. Without this rule Apache looks for a
  # matching file on disk, finds nothing, and returns 404 on every deep link and
  # every page refresh.
  #
  # Real files (assets, favicon, robots.txt) are served normally; everything
  # else falls through to index.html so the app can route it.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ /index.html [L]
</IfModule>

# --------------------------------------------------------------------- headers
<IfModule mod_headers.c>
  # Without includeSubDomains — see deploy/nginx.conf for why: other subdomains
  # of this domain are run by separate systems and would be forced to HTTPS.
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"

  # Keep the staff portal and anything carrying a customer reference out of
  # search results, even if a URL is shared or leaks through a referrer.
  #
  # Update the first pattern if you change ADMIN_PATH.
  <If "%{REQUEST_URI} =~ m#^/staff-portal-9f3c#">
    Header always set X-Robots-Tag "noindex, nofollow, noarchive"
  </If>
  <If "%{REQUEST_URI} =~ m#^/(checkout|order/|booking/|quote/)#">
    Header always set X-Robots-Tag "noindex, nofollow, noarchive"
  </If>

  # Content Security Policy. `connect-src` must list the API subdomain, or the
  # browser will block every call the site makes to it.
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: https:; connect-src 'self' https://api.hdstradingopc.com; frame-src https://checkout.paymongo.com https://www.facebook.com; form-action 'self' https://checkout.paymongo.com; object-src 'none'; base-uri 'self'; upgrade-insecure-requests"

  # index.html must never be cached, or visitors keep loading the old app after
  # a deploy. The asset filenames contain a content hash, so those are safe to
  # cache hard.
  <FilesMatch "\.(html)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(js|css|woff2|svg|png|jpg|jpeg|webp|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "(robots\.txt|sitemap\.xml|site\.webmanifest)$">
    Header set Cache-Control "public, max-age=3600"
  </FilesMatch>
</IfModule>

# ----------------------------------------------------------------- compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE application/xml image/svg+xml
  AddOutputFilterByType DEFLATE application/manifest+json
</IfModule>

# ----------------------------------------------------------------- mime types
<IfModule mod_mime.c>
  AddType application/manifest+json .webmanifest
  AddType image/svg+xml .svg
</IfModule>

# The SPA fallback above already returns index.html for unknown paths, so the
# app's own 404 page is what visitors see.
ErrorDocument 404 /index.html
