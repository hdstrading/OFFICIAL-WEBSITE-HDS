# =============================================================================
# HDS Trading OPC — hdstradingopc.com
#
# Copy this file to `.env` and fill it in. Never commit `.env` to git.
#   cp .env.example .env
# =============================================================================

# --- Core -------------------------------------------------------------------

NODE_ENV=production
PORT=4000

# Interface to listen on. Loopback by default, so the application is reachable
# only through nginx on the same machine — never directly on its port, which
# would bypass HTTPS, the security headers and nginx's rate limiting.
# Change this only if you run without a reverse proxy.
HOST=127.0.0.1

# Your public address. Used for canonical URLs, the sitemap, emails and the
# return URLs the payment gateway sends customers back to.
SITE_URL=https://hdstradingopc.com

# Where the SQLite database file lives. Back this file up — it holds every
# order, booking, quotation and review.
DATABASE_FILE=/var/www/hdstradingopc/server/data/hds.db


# --- Staff portal -----------------------------------------------------------

# The secret path the admin panel is served at. Pick something nobody would
# guess and do not share it publicly.
#
# IMPORTANT: this must match VITE_ADMIN_PATH below, and the client must be
# rebuilt after you change it (`npm run build`).
ADMIN_PATH=staff-portal-9f3c
VITE_ADMIN_PATH=staff-portal-9f3c

ADMIN_EMAIL=admin@hdstradingopc.com

# Use a long, unique password. Generate one with:  openssl rand -base64 24
ADMIN_PASSWORD=

# Signs admin session cookies. Generate with:  openssl rand -hex 32
# Changing this signs everyone out.
SESSION_SECRET=

# Hours before a signed-in staff member has to sign in again.
SESSION_TTL_HOURS=12


# --- Email ------------------------------------------------------------------
# Order, booking and quotation confirmations. Leave blank and the site still
# works — emails are logged to the console instead of being sent.
#
# For a Gmail/Google Workspace account use an App Password, not the account
# password: https://myaccount.google.com/apppasswords

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=HDS Trading OPC <no-reply@hdstradingopc.com>

# Where new orders, bookings and enquiries are emailed internally.
NOTIFY_EMAIL=hanepditoshop@gmail.com


# --- Payments (PayMongo) ----------------------------------------------------
# Accepts Visa, Mastercard, GCash, Maya and online bank transfer under one
# account. Sign up at https://dashboard.paymongo.com
#
# Leave blank to launch without online payments — the checkout automatically
# hides card and e-wallet options and offers bank transfer and cash on
# delivery instead.
#
# Use sk_test_/pk_test_ keys until you are ready to take real money.

PAYMONGO_SECRET_KEY=
PAYMONGO_PUBLIC_KEY=

# Create a webhook in the PayMongo dashboard pointing at:
#   https://hdstradingopc.com/api/webhooks/paymongo
# subscribed to `checkout_session.payment.paid`, then paste its signing secret
# here. Without this, orders are never automatically marked as paid.
PAYMONGO_WEBHOOK_SECRET=

# Percentage of a service booking taken up front as a down payment.
BOOKING_DEPOSIT_PERCENT=30


# --- Delivery ---------------------------------------------------------------

# Where our own vehicles and the couriers collect from. The coordinates are
# used to work out delivery distance — get them from Google Maps by
# right-clicking your warehouse.
WAREHOUSE_ADDRESS=Taytay, Rizal, Philippines
WAREHOUSE_LAT=14.5578
WAREHOUSE_LNG=121.1327
WAREHOUSE_CONTACT_NAME=HDS Trading Dispatch
WAREHOUSE_CONTACT_PHONE=+639171637359

# Lalamove — https://partnerportal.lalamove.com
# Without keys the site still offers Lalamove, priced with our own indicative
# rate table and confirmed with the customer before dispatch.
LALAMOVE_API_KEY=
LALAMOVE_API_SECRET=
LALAMOVE_MARKET=PH
# Switch to https://rest.lalamove.com when you go live with real bookings.
LALAMOVE_BASE_URL=https://rest.sandbox.lalamove.com

# Transportify — request API access from your account manager.
TRANSPORTIFY_API_KEY=
TRANSPORTIFY_BASE_URL=https://api.transportify.com.ph


# --- Booking calendar -------------------------------------------------------

# How many crews can be dispatched per time slot per day. Raise this as you
# hire; the customer-facing calendar updates immediately.
BOOKING_SLOT_CAPACITY=2

# How far ahead customers can book, and how much notice you need.
BOOKING_HORIZON_DAYS=90
BOOKING_LEAD_TIME_DAYS=1


# --- Inventory system -------------------------------------------------------
# The warehouse system at inventory.hdstradingopc.com. It owns stock, and a paid
# website order becomes a confirmed Sales Order there.
#
# Leave the URL or key blank and the website works exactly as before — orders
# are recorded here and simply not sent. Nothing is lost: once configured, use
# "Send all now" in the staff portal under Warehouse to deliver the backlog.
#
# The key is the one set in the inventory system under Settings → Integration.

INVENTORY_API_URL=https://inventory.hdstradingopc.com
INVENTORY_API_KEY=

# Identifies the website in the inventory system's audit log.
INVENTORY_CLIENT_NAME=website

# Set false to stop sending without unconfiguring — useful during a stock take.
INVENTORY_PUSH_ORDERS=true

# Which warehouse fulfils website orders. Blank uses the inventory system's
# primary warehouse.
INVENTORY_WAREHOUSE_ID=

# How often to retry orders that did not get through.
INVENTORY_RETRY_MINUTES=5
INVENTORY_TIMEOUT_MS=15000


# --- Zoho Inventory (legacy, optional) --------------------------------------
# Superseded by the inventory system above. Left in place for the original
# Zoho setup; leave disabled unless you are still using it.

ZOHO_SYNC_ENABLED=false
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_ORGANIZATION_ID=
ZOHO_REGION=com


# --- Split hosting (optional) -----------------------------------------------
# Only needed if you serve the WEBSITE from the IONOS webspace and run the API
# on a separate VPS. Leave all three at their defaults for the simpler setup
# where one VPS serves both.
#
# The API's public address. Baked into the browser bundle at build time, so
# rebuild (`npm run build:webspace`) after changing it.
# VITE_API_BASE_URL=https://api.hdstradingopc.com
#
# Which websites are allowed to call the API. Must list your real site address
# exactly — scheme included, no trailing slash.
# CORS_ORIGINS=https://hdstradingopc.com,https://www.hdstradingopc.com
#
# Leave this as `lax`. It works for a subdomain API, because
# api.hdstradingopc.com and hdstradingopc.com share a registrable domain.
# Only use `none` if the API is on a genuinely different domain — that makes
# the session a third-party cookie, which Safari blocks and Chrome is phasing
# out, so staff would be unable to stay signed in.
# SESSION_COOKIE_SAMESITE=lax


# --- Development only -------------------------------------------------------
# Origins allowed to call the API from a different port during local
# development. In the single-server setup the site and API share one origin,
# so this is not used in production.
CORS_ORIGINS=http://localhost:3000
